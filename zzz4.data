html
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
    <title>Qono AI | Pro Ultimate</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg: #0d0d0d;
            --card: #141414;
            --accent: #1a73e8; 
            --accent-glow: rgba(26, 115, 232, 0.15);
            --border: rgba(255, 255, 255, 0.04);
            --text: #f8f9fa;
            --text-dim: #9aa0a6;
        }

        ::-webkit-scrollbar { width: 5px; height: 5px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.1); border-radius: 10px; }

        * { box-sizing: border-box; -webkit-tap-highlight-color: transparent; outline: none; }
        
        body {
            margin: 0; background: var(--bg); color: var(--text);
            font-family: 'Plus Jakarta Sans', sans-serif;
            height: 100vh; display: flex; flex-direction: column; overflow: hidden;
            transition: background 0.4s ease;
        }

        .header {
            padding: calc(env(safe-area-inset-top) + 15px) 20px 15px;
            display: flex; justify-content: space-between; align-items: center;
            background: rgba(13, 13, 13, 0.7);
            backdrop-filter: blur(25px); border-bottom: 1px solid var(--border);
            z-index: 100; position: relative;
        }

        .menu-trigger { background: transparent; border: none; color: var(--text); cursor: pointer; border-radius: 50%; padding: 8px; display: flex; align-items: center; justify-content: center; }

        .brand { display: flex; align-items: center; gap: 10px; font-weight: 800; font-size: 18px; letter-spacing: 1px; position: absolute; left: 50%; transform: translateX(-50%); }
        .logo-svg { width: 26px; height: 26px; color: var(--accent); filter: drop-shadow(0 0 10px var(--accent-glow)); transition: 0.3s; }

        .acc-link { 
            text-decoration: none; color: var(--accent); border: 1.5px solid var(--accent); 
            padding: 0 18px; border-radius: 30px; font-weight: 700; font-size: 11px; 
            display: flex; align-items: center; justify-content: center; transition: 0.3s;
            height: 34px; min-width: 90px;
        }
        .acc-link:hover { background: var(--accent); color: white; box-shadow: 0 0 15px var(--accent-glow); }

        .chat-container { flex: 1; overflow-y: auto; padding: 20px; display: flex; flex-direction: column; gap: 20px; padding-bottom: 110px; }
        
        .welcome-title { 
            font-size: 32px; font-weight: 800; margin-top: 50px; text-align: center;
            background: linear-gradient(180deg, #fff, #888); 
            -webkit-background-clip: text; -webkit-text-fill-color: transparent;
        }

        .msg { 
            max-width: 80%; padding: 16px 22px; border-radius: 30px; font-size: 15px; 
            line-height: 1.6; animation: msgPop 0.3s ease-out; word-wrap: break-word;
            position: relative;
        }
        @keyframes msgPop { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
        
        .user-msg { align-self: flex-end; background: var(--accent); color: white; border-bottom-right-radius: 4px; box-shadow: 0 5px 15px var(--accent-glow); }
        .ai-msg { align-self: flex-start; background: var(--card); border: 1px solid var(--border); border-bottom-left-radius: 4px; }

        /* Siyah terminal kalktı, canlı veri akışı için stil */
        .live-data {
            font-family: 'JetBrains Mono', monospace; font-size: 13px; color: var(--accent);
            display: block; margin-top: 10px; padding-top: 10px; border-top: 1px solid rgba(255,255,255,0.05);
            word-break: break-all;
        }

        .input-bar { position: fixed; bottom: 0; left: 0; right: 0; padding: 20px; background: linear-gradient(0deg, var(--bg) 70%, transparent); }
        .input-inner { 
            background: #1a1a1a; border: 1px solid var(--border); border-radius: 40px; 
            padding: 6px 6px 6px 22px; display: flex; align-items: center; gap: 10px; transition: 0.3s;
        }
        .input-inner:focus-within { border-color: var(--accent); box-shadow: 0 0 25px var(--accent-glow); }
        
        input { flex: 1; background: transparent; border: none; color: white; font-size: 15px; height: 44px; }
        .send-btn { 
            width: 44px; height: 44px; background: var(--accent); border: none; border-radius: 50%; 
            color: white; display: flex; align-items: center; justify-content: center; cursor: pointer;
        }

        .drawer { position: fixed; inset: 0; background: rgba(0,0,0,0.8); z-index: 2000; visibility: hidden; opacity: 0; transition: 0.3s; backdrop-filter: blur(5px); }
        .drawer.active { visibility: visible; opacity: 1; }
        .drawer-content { 
            position: absolute; left: 10px; top: 10px; bottom: 10px; width: 280px; 
            background: #0d0d0d; border: 1px solid var(--border); border-radius: 24px;
            transform: translateX(-110%); transition: 0.3s; padding: 30px 20px; display: flex; flex-direction: column;
        }
        .drawer.active .drawer-content { transform: translateX(0); }
        
        .sidebar-btn { background: var(--accent); color: white; border: none; padding: 14px; border-radius: 30px; font-weight: 700; margin-bottom: 25px; cursor: pointer; }
        .history-list { flex: 1; overflow-y: auto; }
        .history-item { padding: 14px 18px; background: rgba(255,255,255,0.03); border-radius: 20px; font-size: 13px; margin-bottom: 8px; cursor: pointer; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; border: 1px solid transparent; }
        .history-item.active { background: var(--accent-glow); color: var(--accent); border-color: var(--accent); }

        .header-neon-line { position: absolute; bottom: -1px; left: -100%; width: 100%; height: 2px; background: linear-gradient(90deg, transparent, var(--accent), transparent); opacity: 0; }
        body.is-thinking .header-neon-line { opacity: 1; animation: neonFlow 2s linear infinite; }
        @keyframes neonFlow { 0% { left: -100%; } 100% { left: 100%; } }
    </style>
</head>
<body>

<div class="drawer" id="drawer" onclick="toggleDrawer()">
    <div class="drawer-content" onclick="event.stopPropagation()">
        <button class="sidebar-btn" onclick="startNewChat()">YENİ OTURUM</button>
        <div class="history-list" id="history-list"></div>
    </div>
</div>

<header class="header">
    <button class="menu-trigger" onclick="toggleDrawer()">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
    </button>
    <div class="brand">
        <svg class="logo-svg" id="main-logo" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path d="M11 3 c 0 4.4 -3.6 8 -8 8 c 4.4 0 8 3.6 8 8 c 0 -4.4 3.6 -8 8 -8 c -4.4 0 -8 -3.6 -8 -8 z" />
            <line x1="20" y1="2" x2="20" y2="8" /><line x1="17" y1="5" x2="23" y2="5" /><circle cx="4" cy="20" r="1.5" />
        </svg>
        <span>QONO</span>
    </div>
    <a href="https://fixing-by.github.io/FIXING-ACCOUNT/" class="acc-link" id="acc-btn">HESAP</a>
    <div class="header-neon-line" id="neon-line"></div>
</header>

<main class="chat-container" id="chat-box"></main>

<div class="input-bar">
    <div class="input-inner">
        <input type="text" id="user-input" placeholder="Yazmaya başla..." onkeypress="if(event.key==='Enter') sendMessage()">
        <button class="send-btn" onclick="sendMessage()">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z"/></svg>
        </button>
    </div>
</div>

<script>
    const API_KEY = "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";
    let currentChatId = null;

    function setAccent(color) {
        document.documentElement.style.setProperty('--accent', color);
        let glow = color.startsWith("#") ? color + '26' : color;
        document.documentElement.style.setProperty('--accent-glow', glow);
        const neon = document.getElementById('neon-line');
        if(neon) neon.style.background = `linear-gradient(90deg, transparent, ${color}, transparent)`;
        localStorage.setItem('qono_theme_color_pro', color);
    }

    function startNewChat() {
        currentChatId = Date.now();
        document.getElementById('chat-box').innerHTML = `<div class="welcome-title">Hoş Geldin, ${localStorage.getItem('aktifKullanici') || 'Kullanıcı'}</div>`;
        loadHistory();
    }

    async function sendMessage() {
        const input = document.getElementById('user-input');
        const text = input.value.trim();
        if(!text) return;

        if(text.toLowerCase().startsWith("temayı ") && text.toLowerCase().includes(" yap")) {
            const renk = text.toLowerCase().replace("temayı ", "").replace(" yap", "").trim();
            const renkler = {"kırmızı":"#ff4b2b", "yeşil":"#00ff88", "mavi":"#1a73e8", "mor":"#a855f7", "sarı":"#ffae00", "beyaz":"#ffffff", "turuncu":"#ff8800", "cyan":"#00ffff"};
            const finalColor = renkler[renk] || renk;
            if(finalColor.startsWith("#") || finalColor.startsWith("rgb")) {
                setAccent(finalColor);
                appendMsg(text, 'user');
                appendMsg(`Tema rengi başarıyla güncellendi!`, 'ai');
                input.value = ''; return;
            }
        }

        document.querySelector('.welcome-title')?.remove();
        appendMsg(text, 'user');
        input.value = '';
        document.body.classList.add('is-thinking');

        const history = Array.from(document.querySelectorAll('.msg')).map(m => ({
            role: m.classList.contains('user-msg') ? 'user' : 'assistant',
            content: m.dataset.raw || m.innerText
        }));

        try {
            const res = await fetch('https://api.groq.com/openai/v1/chat/completions', {
                method: 'POST',
                headers: { 'Authorization': `Bearer ${API_KEY}`, 'Content-Type': 'application/json' },
                body: JSON.stringify({ 
                    model: "llama-3.3-70b-versatile", 
                    messages: [
                        {role: "system", content: "Sen Qono AI'sın. KURALLAR:\n1. Renkleri (#hex) Metin formatında kullan.\n2. Sayı sayma/hesaplama gerekirse 'Veriler akıyor...' yaz ve sonuna [GHOST_LOGIC: tip] ekle.\n3. Youtube/Google dersen açılır.\n4. Sonuna [TITLE:Başlık] ekle."}, 
                        ...history
                    ] 
                })
            });
            const data = await res.json();
            let aiMsg = data.choices[0].message.content;

            if(aiMsg.toLowerCase().includes("youtube açılıyor")) window.open('https://youtube.com', '_blank');
            if(aiMsg.toLowerCase().includes("google açılıyor")) window.open('https://google.com', '_blank');

            const titleMatch = aiMsg.match(/\[TITLE:(.*?)\]/);
            if(titleMatch) { updateTitle(titleMatch[1]); aiMsg = aiMsg.replace(titleMatch[0], ""); }

            if(aiMsg.includes("[GHOST_LOGIC:")) {
                const logicType = aiMsg.match(/\[GHOST_LOGIC: (.*?)\]/)[1];
                aiMsg = aiMsg.replace(/\[GHOST_LOGIC: .*?\]/, "");
                appendMsg(aiMsg, 'ai', logicType);
            } else {
                appendMsg(aiMsg, 'ai');
            }
            saveHistory();
        } catch (e) { appendMsg("Hata oluştu.", "ai"); }
        finally { document.body.classList.remove('is-thinking'); }
    }

    function parseColors(text) {
        const regex = /\((#[a-fA-F0-9]{3,6})\)\s*([^()#\n]+)/g;
        return text.replace(regex, (match, hex, content) => `<span style="color:${hex}; font-weight:600;">${content}</span>`);
    }

    function appendMsg(content, role, logicType = null) {
        const box = document.getElementById('chat-box');
        const div = document.createElement('div');
        div.className = `msg ${role === 'user' ? 'user-msg' : 'ai-msg'}`;
        div.dataset.raw = content;

        if(role === 'ai') {
            div.innerHTML = parseColors(content);
            if(logicType) {
                // Siyah terminal yerine doğrudan mesaj içine span ekle
                const liveArea = document.createElement('span');
                liveArea.className = 'live-data';
                div.appendChild(liveArea);
                runLogic(logicType, liveArea, box);
            }
        } else { div.innerText = content; }
        
        box.appendChild(div);
        box.scrollTo({ top: box.scrollHeight, behavior: 'smooth' });
    }

    function runLogic(type, el, container) {
        let current = 0;
        let limit = 1000000000;
        let isPrimeSearch = type.includes('prime');

        const interval = setInterval(() => {
            let chunk = "";
            for(let k=0; k<15; k++) {
                if(current > limit) { clearInterval(interval); return; }
                if(isPrimeSearch) {
                    if(isPrime(current)) chunk += current + " ";
                } else {
                    chunk += current + " ";
                }
                current++;
            }
            el.innerText += chunk;
            container.scrollTop = container.scrollHeight;
            
            // Performans için çok uzarsa buda
            if(el.innerText.length > 3000) el.innerText = "..." + el.innerText.slice(-1500);
        }, 5);
    }

    function isPrime(num) {
        if (num <= 1) return false;
        if (num <= 3) return true;
        if (num % 2 === 0 || num % 3 === 0) return false;
        for (let i = 5; i * i <= num; i = i + 6)
            if (num % i === 0 || num % (i + 2) === 0) return false;
        return true;
    }

    function saveHistory() {
        let history = JSON.parse(localStorage.getItem('qono_chats_pro_rounded') || '[]');
        const msgs = Array.from(document.querySelectorAll('.msg')).map(m => ({ role: m.classList.contains('user-msg') ? 'user' : 'assistant', content: m.dataset.raw }));
        const idx = history.findIndex(c => c.id === currentChatId);
        if(idx > -1) history[idx].messages = msgs;
        else history.push({ id: currentChatId, title: "Sohbet", messages: msgs });
        localStorage.setItem('qono_chats_pro_rounded', JSON.stringify(history));
        loadHistory();
    }

    function updateTitle(t) {
        let history = JSON.parse(localStorage.getItem('qono_chats_pro_rounded') || '[]');
        const idx = history.findIndex(c => c.id === currentChatId);
        if(idx > -1) { history[idx].title = t; localStorage.setItem('qono_chats_pro_rounded', JSON.stringify(history)); loadHistory(); }
    }

    function loadHistory() {
        const list = document.getElementById('history-list');
        const history = JSON.parse(localStorage.getItem('qono_chats_pro_rounded') || '[]');
        list.innerHTML = history.reverse().map(c => `<div class="history-item ${c.id === currentChatId ? 'active' : ''}" onclick="switchChat(${c.id})">${c.title}</div>`).join('');
    }

    function switchChat(id) {
        currentChatId = id;
        const history = JSON.parse(localStorage.getItem('qono_chats_pro_rounded') || '[]');
        const chat = history.find(c => c.id === id);
        if(chat) {
            document.getElementById('chat-box').innerHTML = '';
            chat.messages.forEach(m => appendMsg(m.content, m.role));
        }
        toggleDrawer(); loadHistory();
    }

    function toggleDrawer() { document.getElementById('drawer').classList.toggle('active'); }

    window.onload = () => {
        const savedColor = localStorage.getItem('qono_theme_color_pro');
        if(savedColor) setAccent(savedColor);
        const user = localStorage.getItem('aktifKullanici');
        if(user) document.getElementById('acc-btn').innerText = user;
        startNewChat();
    };
</script>
</body>
</html>

